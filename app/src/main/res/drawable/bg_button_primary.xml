<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33FFFFFF">
    <item>
        <layer-list>
            <item android:top="2dp">
                <shape>
                    <solid android:color="#33376650" />
                    <corners android:radius="24dp" />
                </shape>
            </item>
            <item android:bottom="2dp">
                <shape>
                    <corners android:radius="24dp" />
                    <gradient
                        android:angle="0"
                        android:startColor="#76A88C"
                        android:centerColor="@color/accent_mid"
                        android:endColor="@color/accent_dark" />
                    <stroke
                        android:width="1dp"
                        android:color="#66376650" />
                    <padding
                        android:left="16dp"
                        android:top="10dp"
                        android:right="16dp"
                        android:bottom="10dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
