<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#2AE6B17B">
    <item>
        <shape>
            <corners android:radius="24dp" />
            <gradient
                android:angle="0"
                android:startColor="#FFFFFF"
                android:centerColor="#FFF9F1"
                android:endColor="@color/peach_soft" />
            <stroke
                android:width="1dp"
                android:color="#80E6B17B" />
            <padding
                android:left="14dp"
                android:top="9dp"
                android:right="14dp"
                android:bottom="9dp" />
        </shape>
    </item>
</ripple>
